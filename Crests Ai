<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mini AI Chat</title>

<style>
  body {
    margin: 0;
    font-family: Arial;
    background: #0f172a;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
  }

  .chatbox {
    width: 95%;
    max-width: 400px;
    height: 80vh;
    background: #1e293b;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .header {
    padding: 15px;
    background: #111827;
    text-align: center;
    font-weight: bold;
  }

  .messages {
    flex: 1;
    padding: 10px;
    overflow-y: auto;
  }

  .msg {
    margin: 8px 0;
    padding: 10px;
    border-radius: 10px;
    max-width: 80%;
  }

  .user {
    background: #3b82f6;
    align-self: flex-end;
  }

  .bot {
    background: #334155;
    align-self: flex-start;
  }

  .inputBox {
    display: flex;
    border-top: 1px solid #334155;
  }

  input {
    flex: 1;
    padding: 12px;
    border: none;
    outline: none;
  }

  button {
    padding: 12px;
    background: #22c55e;
    border: none;
    color: white;
    cursor: pointer;
  }
</style>
</head>

<body>

<div class="chatbox">
  <div class="header">Mini AI Assistant 🤖</div>

  <div class="messages" id="messages"></div>

  <div class="inputBox">
    <input id="input" placeholder="Say something..." />
    <button onclick="send()">Send</button>
  </div>
</div>

<script>
  function addMessage(text, type) {
    const msg = document.createElement("div");
    msg.classList.add("msg", type);
    msg.innerText = text;

    document.getElementById("messages").appendChild(msg);
    msg.scrollIntoView();
  }

  function botReply(input) {
    input = input.toLowerCase();

    if (input.includes("hello")) return "Hi 👋 how are you?";
    if (input.includes("how are you")) return "I'm just code, but I'm doing great 😄";
    if (input.includes("name")) return "I'm your mini AI assistant 🤖";
    if (input.includes("time")) return "Check your phone clock ⏰";
    if (input.includes("joke")) return "Why do programmers prefer dark mode? Because light attracts bugs 😂";
    if (input.includes("bye")) return "Goodbye 👋 come back soon!";

    return "Hmm 🤔 I don't fully understand yet, but I'm learning...";
  }

  function send() {
    const input = document.getElementById("input");
    const text = input.value;

    if (!text) return;

    addMessage(text, "user");
    input.value = "";

    setTimeout(() => {
      const reply = botReply(text);
      addMessage(reply, "bot");
    }, 500);
  }
</script>

</body>
</html>
